# Environment
.env
.env.*
!.env.example

# Account stores — NEVER commit (credentials / tokens)
accounts.json
accounts.enc
accounts.*.migrated
accounts.json.migrated

# Local message history and per-user display settings
messages.db
messages.db-journal
display_settings.json

# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Build. The packaged app now sits next to src/ rather than under dist/:
# the launcher at the root and the runtime tree it loads beside it.
build/
dist/
/All-in-one-Email.exe
/_internal/
installer/Output/
*.egg-info/

# Release installers — too large for git (exe) or just a renamed copy of
# linux_installer.sh made for a Release upload; both are published as GitHub
# Release assets via `gh release upload`, not committed here. The tracked
# source script stays linux_installer.sh.
/All-in-one-Email-Setup-*.exe
/All-in-one-Email-Setup-*.sh

